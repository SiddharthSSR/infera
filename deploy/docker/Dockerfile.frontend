# Stage 1: Build React app
FROM node:20.19.0-alpine@sha256:8bda036ddd59ea51a23bc1a1035d3b5c614e72c01366d989f4120e8adca196d4 AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_PUBLIC_ANALYTICS_ENABLED=true
ENV VITE_PUBLIC_ANALYTICS_ENABLED=${VITE_PUBLIC_ANALYTICS_ENABLED}
ARG VITE_DESIGN_PARTNER_REQUEST_ENDPOINT
ENV VITE_DESIGN_PARTNER_REQUEST_ENDPOINT=${VITE_DESIGN_PARTNER_REQUEST_ENDPOINT}
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:1.31.3-alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752

ARG SOURCE_REVISION=unreviewed
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}"

COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p /var/cache/nginx /var/run /var/log/nginx /tmp/nginx \
    && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run /var/log/nginx /tmp/nginx \
    && sed -i -E 's|^[[:space:]]*pid[[:space:]]+[^;]+;|pid /tmp/nginx/nginx.pid;|' /etc/nginx/nginx.conf

USER nginx
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
