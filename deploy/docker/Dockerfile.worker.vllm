# Infera Worker - vLLM Production Image for RunPod
#
# This Dockerfile mirrors the modern worker runtime expectations used by the
# current branch. It deliberately verifies the installed vLLM API surface at
# build time so image/code mismatches fail before deployment.

# The reviewed engine-phase2 runtime is itself derived from the RunPod
# 2.4.0/Python 3.11/CUDA 12.4.1 image. Its content digest locks the complete
# known-compatible vLLM/PyTorch/CUDA dependency environment.
FROM docker.io/codingtensor/worker-vllm:engine-phase2@sha256:e3f6253d4c767d815fd6809b99d1f22fe24469472c53d3945ba8ec7f71d52331

WORKDIR /app

ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}"

# Remove the dependency image's old editable application before introducing the
# explicitly reviewed source archive.
RUN pip uninstall -y infera-worker && \
    find /app -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +

# Verify that the immutable runtime base still matches the reviewed active
# transitive dependency inventory. No apt or remote pip resolution occurs.
COPY python/requirements/worker-vllm.lock /tmp/worker-vllm.lock
COPY python/requirements/worker-vllm.lock.sha256 /tmp/worker-vllm.lock.sha256
RUN cd /tmp && sha256sum -c worker-vllm.lock.sha256
RUN python - <<'PY'
import importlib.metadata
from pathlib import Path

failures = []
for raw_line in Path("/tmp/worker-vllm.lock").read_text(encoding="utf-8").splitlines():
    line = raw_line.strip()
    if not line or line.startswith("#"):
        continue
    name, expected = line.split("==", 1)
    try:
        actual = importlib.metadata.version(name)
    except importlib.metadata.PackageNotFoundError:
        failures.append(f"{name}: missing (expected {expected})")
        continue
    if actual != expected:
        failures.append(f"{name}: {actual} (expected {expected})")
if failures:
    raise SystemExit("worker dependency lock mismatch:\n" + "\n".join(failures))
PY
RUN rm /tmp/worker-vllm.lock /tmp/worker-vllm.lock.sha256

COPY python/pyproject.toml python/README.md ./
COPY python/src/infera_worker/ ./src/infera_worker/

# Install the worker package and fail the build if the image cannot satisfy the
# current vLLM runtime contract.
RUN pip install --no-cache-dir --no-deps --no-build-isolation --force-reinstall . && \
    echo "=== Verifying installation ===" && \
    python -c "import torch; print(f'PyTorch {torch.__version__}, CUDA: {torch.version.cuda}')" && \
    python -c "import transformers; print(f'Transformers {transformers.__version__}')" && \
    python -c "import vllm; print(f'vLLM {vllm.__version__}')" && \
    python -c "from vllm import AsyncLLMEngine, AsyncEngineArgs, SamplingParams; print('vLLM imports OK')" && \
    python -c "import inspect; from vllm import AsyncEngineArgs; required = {'model', 'tensor_parallel_size', 'gpu_memory_utilization', 'max_model_len'}; missing = sorted(required.difference(inspect.signature(AsyncEngineArgs).parameters)); assert not missing, f'Missing AsyncEngineArgs kwargs: {missing}'" && \
    python -c "from infera_worker.engines.vllm_engine import VLLMEngine; print('VLLMEngine OK')"

ENV INFERA_ENGINE=vllm
ENV INFERA_HTTP_PORT=8081
ENV INFERA_GRPC_PORT=50051
ENV INFERA_LOG_LEVEL=INFO
ENV INFERA_LOG_FORMAT=json
ENV INFERA_TRUST_REMOTE_CODE=false
ENV INFERA_MODEL_CACHE_SIZE=2

# Keep model artifacts on the mounted workspace volume when available.
ENV XDG_CACHE_HOME=/workspace/.cache
ENV HF_HOME=/workspace/.cache/huggingface
ENV HUGGINGFACE_HUB_CACHE=/workspace/.cache/huggingface/hub
ENV TRANSFORMERS_CACHE=/workspace/.cache/huggingface/hub
ENV TORCH_HOME=/workspace/.cache/torch

# vLLM V1 uses multiprocessing; spawn avoids CUDA fork issues in containers.
ENV VLLM_WORKER_MULTIPROC_METHOD=spawn
ENV VLLM_USE_MODELSCOPE=false

ENV INFERA_ROUTER_ADDRESS=""
ENV INFERA_PRELOAD_MODELS=""

EXPOSE 8081 50051

HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8081/health', timeout=5)" || exit 1

CMD ["python", "-m", "infera_worker.cli"]
