.git
.gitignore

# This denylist reduces generic repository build contexts; it does not prove
# that inputs are tracked or reviewed. Frontend releases must use
# scripts/build-reviewed-frontend.sh, which materializes an explicit Git commit.
.env
.env.*
**/.env
**/.env.*
recovery-evidence
**/recovery-evidence
**/recovery-evidence/**
output
**/output
**/output/**
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/coverage
**/coverage/**
**/.vite
**/.vite/**
**/.cache
**/.cache/**
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.venv
**/venv
**/.DS_Store
