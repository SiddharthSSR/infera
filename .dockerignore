.git
.gitignore

# Never send local credentials or operational evidence to the Docker daemon.
.env
.env.*
**/.env
**/.env.*
recovery-evidence
output

# Exclude host-generated dependency and build artifacts. Dockerfiles install
# their own dependencies and must build only from tracked source inputs.
**/node_modules
**/dist
**/coverage
**/.vite
**/.cache
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.venv
**/venv

# Host metadata is not a build input.
**/.DS_Store
